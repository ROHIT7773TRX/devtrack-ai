# ============================================================
# DevTrack AI — .gitignore
# ============================================================

# ──────────────────────────────────────────────
# PYTHON / FASTAPI
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/
.tox/
*.log

# ──────────────────────────────────────────────
# NODE / REACT
# ──────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
app/frontend/build/
app/frontend/dist/

# ──────────────────────────────────────────────
# ENVIRONMENT / SECRETS — NEVER COMMIT THESE
# ──────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
secrets.yaml
secrets.json

# ──────────────────────────────────────────────
# TERRAFORM — STATE FILES CONTAIN SECRETS
# ──────────────────────────────────────────────
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/.terraform.lock.hcl
terraform/terraform.tfvars
# Note: terraform.tfvars contains real AWS values — NEVER commit

# ──────────────────────────────────────────────
# AWS CREDENTIALS — ABSOLUTELY NEVER COMMIT
# ──────────────────────────────────────────────
.aws/
credentials
aws-credentials*
*.pem
*.key
id_rsa
id_rsa.pub

# ──────────────────────────────────────────────
# DOCKER
# ──────────────────────────────────────────────
.dockerignore

# ──────────────────────────────────────────────
# EDITORS / IDE
# ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ──────────────────────────────────────────────
# KUBERNETES
# ──────────────────────────────────────────────
# Actual secret values (use secrets template instead)
kubernetes/secret-values.yaml

# ──────────────────────────────────────────────
# PROJECT REFERENCE (synopsis PDF is reference only)
# ──────────────────────────────────────────────
# Uncomment if you do NOT want the PDF in the repo:
# *.pdf
