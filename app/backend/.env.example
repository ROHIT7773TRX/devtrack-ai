# ============================================================
# .env.example
# Template for environment variables.
#
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in .env
# 3. NEVER commit .env to Git (it's in .gitignore)
# 4. This .env.example file IS committed to Git — it's the template
#
# WHY ENVIRONMENT VARIABLES?
# Hard-coding passwords in code is a security disaster.
# Environment variables keep secrets out of source code.
# Different environments (local, Docker, Kubernetes) can use
# different values without changing the code.
# ============================================================

# ── PostgreSQL Database ──────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://devtrack_user:devtrack_pass@localhost:5432/devtrack

POSTGRES_DB=devtrack
POSTGRES_USER=devtrack_user
POSTGRES_PASSWORD=devtrack_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Application ──────────────────────────────────────────────
APP_VERSION=1.0.0
DEBUG=true
